# Copy to .env and adjust. Never commit .env (see .gitignore).
#
# The only difference between development and production is this file
# (NFR-10): the same PostgreSQL engine runs in both, so promoting to managed
# Postgres is a configuration change, not a code change.

# Local Docker Postgres — matches docker-compose.yml (host port 5433)
DATABASE_URL=postgresql+psycopg://susubook:susubook_dev@localhost:5433/susubook

# In production this becomes the managed Postgres connection string, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# Session signing. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Base URL used when building QR card links (FR-39)
BASE_URL=http://localhost:5000

FLASK_ENV=development
